#!/usr/bin/env bash
# T33 hygiene policy dispatcher (workspace-side).
# Resolves the workspace via ~/.gstack/workspace-root and runs the shared
# precommit-check.sh against the sanskrit-texts project. Exits silently if
# the symlink is missing (developers not running the hygiene daemon are not
# blocked).
#
# Bypass: GSTACK_HYGIENE_BYPASS=1 git commit ...
# Strict: GSTACK_HYGIENE_STRICT=1

set -uo pipefail

# --- propagate: declared-coupling check (added 2026-08-19; hardened 2026-08-20 — G48) ---
# Warn-only by design: propagate never edits a downstream, it tells a human.
# --staged is the prescribed pre-commit selector (REFERENCE.md). Never --strict here:
# a coupling is information, not a defect, and blocking teaches people to use --no-verify.
# Bypass: PROPAGATE_SKIP=1 git commit ...
#
# The CLI path is derived, not hardcoded to one location (G48): PROPAGATE_CLI can
# override it; otherwise it falls back to the default skill path, then to a `propagate`
# binary on PATH. If none resolves, this prints exactly one line and does NOT block the
# commit -- a missing gate must never be silent (the prior version was `[ -f ... ] && ...`,
# which skipped with zero output when the CLI moved).
if [ -z "${PROPAGATE_SKIP:-}" ]; then
  PROPAGATE_CLI="${PROPAGATE_CLI:-$HOME/.claude/skills/propagate/cli.mjs}"
  if [ -f "$PROPAGATE_CLI" ]; then
    node "$PROPAGATE_CLI" check --staged || true
  elif command -v propagate >/dev/null 2>&1; then
    propagate check --staged || true
  else
    echo "pre-commit: propagate gate SKIPPED -- cli.mjs not found at $PROPAGATE_CLI (set PROPAGATE_CLI or reinstall the skill)" >&2
  fi
fi
# --- end propagate ---

WS_ROOT="$(readlink "$HOME/.gstack/workspace-root" 2>/dev/null)"
if [ -n "$WS_ROOT" ] && [ -x "$WS_ROOT/scripts/hygiene/precommit-check.sh" ]; then
  bash "$WS_ROOT/scripts/hygiene/precommit-check.sh" sanskrit-texts || exit 1
fi

exit 0
