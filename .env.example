# Copy to .env and adjust. Nothing here is a deployment credential: this database binds
# 127.0.0.1:5433 and holds a public-domain corpus.
#
# TWO ROLES, NEVER ONE — this is the publication gate, not tidiness.
# A table OWNER can re-grant past any REVOKE and is not subject to RLS unless it is FORCEd,
# so a gate built on GRANT is worth nothing if the application connects as owner. compose
# creates only the owner; the API role is created by the migration.

# Owner. Runs migrations and the importer. The application must NEVER hold this.
CORPUS_OWNER_DSN=postgresql+psycopg://corpus_owner:corpus_local_dev@127.0.0.1:5433/sanskrit_texts

# Consumer. SELECT on the published views and NOTHING on annotation/annotation_revision.
CORPUS_API_DSN=postgresql+psycopg://corpus_api:corpus_api_local@127.0.0.1:5433/sanskrit_texts

# The test suite gets its own database, and the TRUNCATE guard REQUIRES the `_test` suffix.
# The development corpus lives on the same host and port; without the suffix rule a test run
# would empty 97,724 real verses and report green. See GOTCHAS G59.
# CORPUS_OWNER_DSN=postgresql+psycopg://corpus_owner:corpus_local_dev@127.0.0.1:5433/sanskrit_texts_test

# Turn a missing database from a SKIP into a FAILURE. CI must set this: without it the
# publication gate suite skips itself and reports green having asserted nothing (G61).
# CORPUS_REQUIRE_DB=1

# Rotates the API role's password on the next `alembic upgrade`. Unset uses the local default.
# CORPUS_API_PASSWORD=

# Port 5433, not 5432 — ports.yml allocates 5432 to Divyansh/AuroraV3/postgres-forward.
# SANSKRIT_PG_PORT=5433
