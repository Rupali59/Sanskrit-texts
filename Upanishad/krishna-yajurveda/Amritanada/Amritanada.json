  "chapters": [
    {
      "number": 1,
      "title": "",
      "shlokas": [
        {
          "number": 1,
          "ref": "amritanada_upanishad 1.1",
          "text": "अमृतनादोपनिषत् २१ अमृतनादोपनिषत्प्रतिपाद्यं पराक्षरम् । त्रैपदानन्दसाम्राज्यं हृदि मे भातु सन्ततम् ॥ ॐ सह नाववतु । सह नौ भुनक्तु । सह वीर्यं करवावहै । तेजस्विनावधीतमस्तु मा विद्विषावहै ॥ ॐ शान्तिः शान्तिः शान्तिः ॥ शास्त्राण्यधीत्य मेधावी अभ्यस्य च पुनः पुनः । परमं ब्रह्म विज्ञाय उल्कावत्तान्यथोत्सृजेत्",
          "english": "",
          "hindi": "",
          "status": "untranslated"
        },
        {
          "number": 2,
          "ref": "amritanada_upanishad 1.2",
          "text": "ओङ्कारं रथमारुह्य विष्णुं कृत्वाथ सारथिम् । ब्रह्मलोकपदान्वेषी रुद्राराधनतत्परः",
          "english": "",
          "hindi": "",
          "status": "untranslated"
        },
        {
          "number": 3,
          "ref": "amritanada_upanishad 1.3",
          "text": "तावद्रथेन गन्तव्यं यावद्रथपथि स्थितः । स्थित्वा रथपथस्थानं रथमुत्सृज्य गच्छति",
          "english": "",
          "hindi": "",
          "status": "untranslated"
        },
        {
          "number": 4,
          "ref": "amritanada_upanishad 1.4",
          "text": "मात्रालिङ्गपदं त्यक्त्वा शब्दव्यञ्जनवर्जितम् । अस्वरेण मकारेण पदं सूक्ष्मं च गच्छति",
          "english": "",
          "hindi": "",
          "status": "untranslated"
        },
        {
          "number": 5,
          "ref": "amritanada_upanishad 1.5",
          "text": "शब्दादिविषयाः पञ्च मनश्चैवातिचञ्चलम् । चिन्तयेदात्मनो रश्मीन्प्रत्याहारः स उच्यते",
          "english": "",
          "hindi": "",
          "status": "untranslated"
        },
        {
          "number": 6,
          "ref": "amritanada_upanishad 1.6",
          "text": "प्रत्याहारस्तथा ध्यानं प्राणायामोऽथ धारणा । तर्कश्चैव समाधिश्च षडङ्गो योग उच्यते",
          "english": "",
          "hindi": "",
          "status": "untranslated"
        },
        {
          "number": 7,
          "ref": "amritanada_upanishad 1.7",
          "text": "यथा पर्वतधातूनां दह्यन्ते धमनान्मलाः । तथेन्द्रियकृता दोषा दह्यन्ते प्राणनिग्रहात्",
          "english": "",
          "hindi": "",
          "status": "untranslated"
        },
        {
          "number": 8,
          "ref": "amritanada_upanishad 1.8",
          "text": "प्राणायामैर्दहेद्दोषान्धारणाभिश्च किल्बिषम् । प्रत्याहारेण संसर्गाद्ध्यानेनानीश्वरान्गुणान्",
          "english": "",
          "hindi": "",
          "status": "untranslated"
        },
        {
          "number": 9,
          "ref": "amritanada_upanishad 1.9",
          "text": "किल्बिषं हि क्षयं नीत्वा रुचिरं चैव चिन्तयेत्",
          "english": "",
          "hindi": "",
          "status": "untranslated"
        },
        {
          "number": 10,
          "ref": "amritanada_upanishad 1.10",
          "text": "रुचिरं रेचकं चैव वायोराकर्षणं तथा । प्राणायामस्त्रयः प्रोक्ता रेचपूरककुम्भकाः",
          "english": "",
          "hindi": "",
          "status": "untranslated"
        },
        {
          "number": 11,
          "ref": "amritanada_upanishad 1.11",
          "text": "सव्याहृतिं सप्रणवां गायत्रीं शिरसा सह । त्रिः पठेदायतप्राणः प्राणायामः स उच्यते",
          "english": "",
          "hindi": "",
          "status": "untranslated"
        },
        {
          "number": 12,
          "ref": "amritanada_upanishad 1.12",
          "text": "उत्क्षिप्य वायुमाकाशं शून्यं कृत्वा निरात्मकम् । शून्यभावेन युञ्जीयाद्रेचकस्येति लक्षणम्",
          "english": "",
          "hindi": "",
          "status": "untranslated"
        },
        {
          "number": 13,
          "ref": "amritanada_upanishad 1.13",
          "text": "वक्त्रेणोत्पलनालेन तोयमाकर्षयेन्नरः । एवं वायुर्ग्रहीतव्यः पूरकस्येति लक्षणम्",
          "english": "",
          "hindi": "",
          "status": "untranslated"
        },
        {
          "number": 14,
          "ref": "amritanada_upanishad 1.14",
          "text": "नोच्छ्वसेन्न च निश्वासेत् गात्राणि नैव चालयेत् । एवं भावं नियुञ्जीयात् कुम्भकस्येति लक्षणम्",
          "english": "",
          "hindi": "",
          "status": "untranslated"
        },
        {
          "number": 15,
          "ref": "amritanada_upanishad 1.15",
          "text": "अन्धवत्पश्य रूपाणि शब्दं बधिरवत् श‍ृणु । काष्ठवत्पश्य ते देहं प्रशान्तस्येति लक्षणम्",
          "english": "",
          "hindi": "",
          "status": "untranslated"
        },
        {
          "number": 16,
          "ref": "amritanada_upanishad 1.16",
          "text": "मनः सङ्कल्पकं ध्यात्वा संक्षिप्यात्मनि बुद्धिमान् । धारयित्वा तथाऽऽत्मानं धारणा परिकीर्तिता",
          "english": "",
          "hindi": "",
          "status": "untranslated"
        },
        {
          "number": 17,
          "ref": "amritanada_upanishad 1.17",
          "text": "आगमस्याविरोधेन ऊहनं तर्क उच्यते । समं मन्येत यं लब्ध्वा स समाधिः प्रकीर्तितः",
          "english": "",
          "hindi": "",
          "status": "untranslated"
        },
        {
          "number": 18,
          "ref": "amritanada_upanishad 1.18",
          "text": "भूमिभागे समे रम्ये सर्वदोषविवर्जिते । कृत्वा मनोमयीं रक्षां जप्त्वा चैवाथ मण्डले",
          "english": "",
          "hindi": "",
          "status": "untranslated"
        },
        {
          "number": 19,
          "ref": "amritanada_upanishad 1.19",
          "text": "पद्मकं स्वस्तिकं वापि भद्रासनमथापि वा । बद्ध्वा योगासनं सम्यगुत्तराभिमुखः स्थितः",
          "english": "",
          "hindi": "",
          "status": "untranslated"
        },
        {
          "number": 20,
          "ref": "amritanada_upanishad 1.20",
          "text": "नासिकापुटमङ्गुल्या पिधायैकेन मारुतम् । आकृष्य धारयेदग्निं शब्दमेवाभिचिन्तयेत्",
          "english": "",
          "hindi": "",
          "status": "untranslated"
        },
        {
          "number": 21,
          "ref": "amritanada_upanishad 1.21",
          "text": "ओमित्येकाक्षरं ब्रह्म ओमित्येकेन रेचयेत् । दिव्यमन्त्रेण बहुशः कुर्यादात्ममलच्युतिम्",
          "english": "",
          "hindi": "",
          "status": "untranslated"
        },
        {
          "number": 22,
          "ref": "amritanada_upanishad 1.22",
          "text": "पश्चाद्ध्यायीत पूर्वोक्तक्रमशो मन्त्रविद्बुधः । स्थूलातिस्थूलमात्रायं नाभेरूर्ध्वरुपक्रमः",
          "english": "",
          "hindi": "",
          "status": "untranslated"
        },
        {
          "number": 23,
          "ref": "amritanada_upanishad 1.23",
          "text": "तिर्यगूर्ध्वमधो दृष्टिं विहाय च महामतिः । स्थिरस्थायी विनिष्कम्पः सदा योगं समभ्यसेत्",
          "english": "",
          "hindi": "",
          "status": "untranslated"
        },
        {
          "number": 24,
          "ref": "amritanada_upanishad 1.24",
          "text": "तालमात्राविनिष्कम्पो धारणायोजनं तथा । द्वादशमात्रो योगस्तु कालतो नियमः स्मृतः",
          "english": "",
          "hindi": "",
          "status": "untranslated"
        },
        {
          "number": 25,
          "ref": "amritanada_upanishad 1.25",
          "text": "अघोषमव्यञ्जनमस्वरं च अकण्ठताल्वोष्ठमनासिकं च । अरेफजातमुभयोष्मवर्जितं यदक्षरं न क्षरते कदाचित्",
          "english": "",
          "hindi": "",
          "status": "untranslated"
        },
        {
          "number": 26,
          "ref": "amritanada_upanishad 1.26",
          "text": "येनासौ पश्यते मार्गं प्राणस्तेन हि गच्छति । अतस्तमभ्यसेन्नित्यं सन्मार्गगमनाय वै",
          "english": "",
          "hindi": "",
          "status": "untranslated"
        },
        {
          "number": 27,
          "ref": "amritanada_upanishad 1.27",
          "text": "हृद्द्वारं वायुद्वारं च मूर्धद्वारमतः परम् । मोक्षद्वारं बिलं चैव सुषिरं मण्डलं विदुः",
          "english": "",
          "hindi": "",
          "status": "untranslated"
        },
        {
          "number": 28,
          "ref": "amritanada_upanishad 1.28",
          "text": "भयं क्रोधमथालस्यमतिस्वप्नातिजागरम् । अत्याहरमनाहरं नित्यं योगी विवर्जयेत्",
          "english": "",
          "hindi": "",
          "status": "untranslated"
        },
        {
          "number": 29,
          "ref": "amritanada_upanishad 1.29",
          "text": "अनेन विधिना सम्यङ्नित्यमभ्यसतः क्रमात् । स्वयमुत्पद्यते ज्ञानं त्रिभिर्मासैर्न संशयः",
          "english": "",
          "hindi": "",
          "status": "untranslated"
        },
        {
          "number": 30,
          "ref": "amritanada_upanishad 1.30",
          "text": "चतुर्भिः पश्यते देवान्पञ्चभिस्तुल्यविक्रमः । इच्छयाप्नोति कैवल्यं षष्ठे मासि न संशयः",
          "english": "",
          "hindi": "",
          "status": "untranslated"
        },
        {
          "number": 31,
          "ref": "amritanada_upanishad 1.31",
          "text": "पार्थिवः पञ्चमात्रस्तु चतुर्मात्राणि वारुणः । आग्नेयस्तु त्रिमात्रोऽसौ वायव्यस्तु द्विमात्रकः",
          "english": "",
          "hindi": "",
          "status": "untranslated"
        },
        {
          "number": 32,
          "ref": "amritanada_upanishad 1.32",
          "text": "एकमात्रस्तथाकाशो ह्यर्धमात्रं तु चिन्तयेत् । सिद्धिं कृत्वा तु मनसा चिन्तयेदात्मनात्मनि",
          "english": "",
          "hindi": "",
          "status": "untranslated"
        },
        {
          "number": 33,
          "ref": "amritanada_upanishad 1.33",
          "text": "त्रिंशत्पर्वाङ्गुलः प्राणो यत्र प्राणः प्रतिष्ठितः । एष प्राण इति ख्यातो बाह्यप्राणस्य गोचरः",
          "english": "",
          "hindi": "",
          "status": "untranslated"
        },
        {
          "number": 34,
          "ref": "amritanada_upanishad 1.34",
          "text": "अशीतिश्च शतं चैव सहस्राणि त्रयोदश । लक्षश्चैकोननिःश्वास अहोरात्रप्रमाणतः",
          "english": "",
          "hindi": "",
          "status": "untranslated"
        },
        {
          "number": 35,
          "ref": "amritanada_upanishad 1.35",
          "text": "प्राण आद्यो हृदिस्थाने अपानस्तु पुनर्गुदे । समानो नाभिदेशे तु उदानः कण्ठमाश्रितः",
          "english": "",
          "hindi": "",
          "status": "untranslated"
        },
        {
          "number": 36,
          "ref": "amritanada_upanishad 1.36",
          "text": "व्यानः सर्वेषु चाङ्गेषु सदा व्यावृत्य तिष्ठति । अथ वर्णास्तु पञ्चानां प्राणादीनामनुक्रमात्",
          "english": "",
          "hindi": "",
          "status": "untranslated"
        },
        {
          "number": 37,
          "ref": "amritanada_upanishad 1.37",
          "text": "रक्तवर्नो मणिप्रख्यः प्राणो वायुः प्रकीर्तितः । अपानस्तस्य मध्ये तु इन्द्रगोपसमप्रभः",
          "english": "",
          "hindi": "",
          "status": "untranslated"
        },
        {
          "number": 38,
          "ref": "amritanada_upanishad 1.38",
          "text": "समानस्तु द्वयोर्मध्ये गोक्षीरधवलप्रभः । आपाण्डर उदानश्च व्यानो ह्यर्चिस्समप्रभः",
          "english": "",
          "hindi": "",
          "status": "untranslated"
        },
        {
          "number": 39,
          "ref": "amritanada_upanishad 1.39",
          "text": "यस्येदं मण्डलं भित्वा मारुतो याति मूर्धनि । यत्र तत्र म्रियेद्वापि न स भूयोऽबिजायते । न स भूयोऽभिजायत इत्युपनिषत्",
          "english": "",
          "hindi": "",
          "status": "untranslated"
        }
      ]
    }
  ]
}
