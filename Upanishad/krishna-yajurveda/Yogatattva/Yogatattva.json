  "chapters": [
    {
      "number": 1,
      "title": "",
      "shlokas": [
        {
          "number": 1,
          "ref": "yogatattva_upanishad 1.1",
          "text": "योगतत्त्वोपनिषत् योगैश्वर्यं च कैवल्यं जायते यत्प्रसादतः । तद्वैष्णवं योगतत्त्वं रामचन्द्रपदं भजे ॥ ॐ सह नाववतु । सह नौ भुनक्तु । सह वीर्यं करवावहै । तेजस्विनावधीतमस्तु मा विद्विषावहै । ॐ शान्तिः शान्तिः शान्तिः ॥ योगतत्त्वं प्रवक्ष्यामि योगिनां हितकाम्यया । यच्छृत्वा च पठित्वा च सर्वपापैः प्रमुच्यते",
          "english": "",
          "hindi": "",
          "status": "untranslated"
        },
        {
          "number": 2,
          "ref": "yogatattva_upanishad 1.2",
          "text": "विष्णुर्नाम महायोगी महाभूतो महातपाः । तत्त्वमार्गे यथा दीपो दृश्यते पुरुषोत्तमः",
          "english": "",
          "hindi": "",
          "status": "untranslated"
        },
        {
          "number": 3,
          "ref": "yogatattva_upanishad 1.3",
          "text": "तमाराध्य जगन्नाथं प्रणिपत्य पितामहः । पप्रच्छ योगतत्त्वं मे ब्रूहि चाष्टाङ्गसंयुतम्",
          "english": "",
          "hindi": "",
          "status": "untranslated"
        },
        {
          "number": 4,
          "ref": "yogatattva_upanishad 1.4",
          "text": "तमुवाच हृषीकेशो वक्ष्यामि श‍ृणु तत्त्वतः । सर्वे जीवाः सुखैर्दुखैर्मायाजालेन वेष्टिताः",
          "english": "",
          "hindi": "",
          "status": "untranslated"
        },
        {
          "number": 5,
          "ref": "yogatattva_upanishad 1.5",
          "text": "तेषां मुक्तिकरं मार्गं मायाजालनिकृन्तनम् । जन्ममृत्युजराव्याधिनाशनं मृत्युतारकम्",
          "english": "",
          "hindi": "",
          "status": "untranslated"
        },
        {
          "number": 6,
          "ref": "yogatattva_upanishad 1.6",
          "text": "नानामार्गैस्तु दुष्प्रापं कैवल्यं परमं पदम् । पतिताः शास्त्रजालेषु प्रज्ञया तेन मोहिताः",
          "english": "",
          "hindi": "",
          "status": "untranslated"
        },
        {
          "number": 7,
          "ref": "yogatattva_upanishad 1.7",
          "text": "अनिर्वाच्यं पदं वक्तुं न शक्यं तैः सुरैरपि । स्वात्मप्रकाशरूपं तत्किं शास्त्रेण प्रकाशते",
          "english": "",
          "hindi": "",
          "status": "untranslated"
        },
        {
          "number": 8,
          "ref": "yogatattva_upanishad 1.8",
          "text": "निष्कलं निर्मलं शान्तं सर्वातीतं निरामयम् । तदेव जीवरूपेण पुण्यपापफलैर्वृतम्",
          "english": "",
          "hindi": "",
          "status": "untranslated"
        },
        {
          "number": 9,
          "ref": "yogatattva_upanishad 1.9",
          "text": "परमात्मपदं नित्यं तत्कथं जीवतां गतम् । सर्वभावपदातीतं ज्ञानरूपं निरञ्जनम्",
          "english": "",
          "hindi": "",
          "status": "untranslated"
        },
        {
          "number": 10,
          "ref": "yogatattva_upanishad 1.10",
          "text": "वारिवत्स्फुरितं तस्मिंस्तत्राहंकृतिरुत्थिता । पञ्चात्मकमभूत्पिण्डं धातुबद्धं गुणात्मकम्",
          "english": "",
          "hindi": "",
          "status": "untranslated"
        },
        {
          "number": 11,
          "ref": "yogatattva_upanishad 1.11",
          "text": "सुखदुःखैः समायुक्तं जीवभावनया कुरु । तेन जीवाभिधा प्रोक्ता विशुद्धैः परमात्मनि",
          "english": "",
          "hindi": "",
          "status": "untranslated"
        },
        {
          "number": 12,
          "ref": "yogatattva_upanishad 1.12",
          "text": "कामक्रोधभयं चापि मोहलोभमदो रजः । जन्ममृत्युश्च कार्पण्यं शोकस्तन्द्रा क्षुधा तृषा",
          "english": "",
          "hindi": "",
          "status": "untranslated"
        },
        {
          "number": 13,
          "ref": "yogatattva_upanishad 1.13",
          "text": "तृष्णा लज्जा भयं दुह्खं विषादो हर्ष एव च । एभिर्दोषैर्विनिर्मुक्तः स जीवः केवलो मतः",
          "english": "",
          "hindi": "",
          "status": "untranslated"
        },
        {
          "number": 14,
          "ref": "yogatattva_upanishad 1.14",
          "text": "तस्माद्दोषविनाशार्थमुपायं कथयामि ते । योगहीनं कथं ज्ञानं मोक्षदं भवति ध्रुवम्",
          "english": "",
          "hindi": "",
          "status": "untranslated"
        },
        {
          "number": 15,
          "ref": "yogatattva_upanishad 1.15",
          "text": "योगो हि ज्ञानहीनस्तु न क्षमो मोक्षकर्मणि । तस्माज्ज्ञानं च योगं च मुमुक्षुर्दृढमभ्यसेत्",
          "english": "",
          "hindi": "",
          "status": "untranslated"
        },
        {
          "number": 16,
          "ref": "yogatattva_upanishad 1.16",
          "text": "अज्ञानादेव संसारो ज्ञानादेव विमुच्यते । ज्ञानस्वरूपमेवादौ ज्ञानं ज्ञेयैकसाधनम्",
          "english": "",
          "hindi": "",
          "status": "untranslated"
        },
        {
          "number": 17,
          "ref": "yogatattva_upanishad 1.17",
          "text": "ज्ञातं येन निजं रूपं कैवल्यं परमं पदम् । निष्कलं निर्मलं साक्षात्सच्चिदानन्दरूपकम्",
          "english": "",
          "hindi": "",
          "status": "untranslated"
        },
        {
          "number": 18,
          "ref": "yogatattva_upanishad 1.18",
          "text": "उत्पत्तिस्थितिसंहारस्फूर्तिज्ञानविवर्जितम् । एतज्ज्ञानमिति प्रोक्तमथ योगं ब्रवीमि ते",
          "english": "",
          "hindi": "",
          "status": "untranslated"
        },
        {
          "number": 19,
          "ref": "yogatattva_upanishad 1.19",
          "text": "योगो हि बहुधा ब्रह्मन्भिद्यते व्यवहारतः । मन्त्रयोगो लयश्चैव हठोऽसौ राजयोगतः",
          "english": "",
          "hindi": "",
          "status": "untranslated"
        },
        {
          "number": 20,
          "ref": "yogatattva_upanishad 1.20",
          "text": "आरम्भश्च घटश्चैव तथा परिचयः स्मृतः । निष्पत्तिश्चेत्यवस्था च सर्वत्र परिकीर्तिता",
          "english": "",
          "hindi": "",
          "status": "untranslated"
        },
        {
          "number": 21,
          "ref": "yogatattva_upanishad 1.21",
          "text": "एतेषां लक्षणं ब्रह्मन्वक्ष्ये श‍ृणु समासतः । मातृकादियुतं मन्त्रं द्वादशाब्दं तु यो जपेत्",
          "english": "",
          "hindi": "",
          "status": "untranslated"
        },
        {
          "number": 22,
          "ref": "yogatattva_upanishad 1.22",
          "text": "क्रमेण लभते ज्ञानमणिमादिगुणान्वितम् । अल्पबुद्धिरिमं योगं सेवते साधकाधमः",
          "english": "",
          "hindi": "",
          "status": "untranslated"
        },
        {
          "number": 23,
          "ref": "yogatattva_upanishad 1.23",
          "text": "लययोगश्चित्तलयः कोटिशः परिकीर्तितः । गच्छंस्तिष्ठन्स्वपन्भुञ्जन्ध्यायेन्निष्कलमीश्वरम्",
          "english": "",
          "hindi": "",
          "status": "untranslated"
        },
        {
          "number": 24,
          "ref": "yogatattva_upanishad 1.24",
          "text": "स एव लययोगः स्याद्धठयोगमतः श‍ृणु । यमश्च नियमश्चैव आसनं प्राणसंयमः",
          "english": "",
          "hindi": "",
          "status": "untranslated"
        },
        {
          "number": 25,
          "ref": "yogatattva_upanishad 1.25",
          "text": "प्रत्याहारो धारणा च ध्यानं भ्रूमध्यमे हरिम् । समाधिः समतावस्था साष्टाङ्गो योग उच्यते",
          "english": "",
          "hindi": "",
          "status": "untranslated"
        },
        {
          "number": 26,
          "ref": "yogatattva_upanishad 1.26",
          "text": "महामुद्रा महाबन्धो महावेधश्च खेचरी । जालन्धरोड्डियाणश्च मूलबन्धैस्तथैव च",
          "english": "",
          "hindi": "",
          "status": "untranslated"
        },
        {
          "number": 27,
          "ref": "yogatattva_upanishad 1.27",
          "text": "दीर्घप्रणवसन्धानं सिद्धान्तश्रवणं परम् । वज्रोली चामरोली च सहजोली त्रिधा मता",
          "english": "",
          "hindi": "",
          "status": "untranslated"
        },
        {
          "number": 28,
          "ref": "yogatattva_upanishad 1.28",
          "text": "एतेषां लक्षणं ब्रह्मन्प्रत्येकं श‍ृणु तत्त्वतः । लघ्वाहारो यमेष्वेको मुख्या भवति नेतरः",
          "english": "",
          "hindi": "",
          "status": "untranslated"
        },
        {
          "number": 29,
          "ref": "yogatattva_upanishad 1.29",
          "text": "अहिंसा नियमेष्वेका मुख्या वै चतुरानन । सिद्धं पद्मं तथा सिंहं भद्रं चेति चतुष्टयम्",
          "english": "",
          "hindi": "",
          "status": "untranslated"
        },
        {
          "number": 30,
          "ref": "yogatattva_upanishad 1.30",
          "text": "प्रथमाभ्यासकाले तु विघ्नाः स्युश्चतुरानन । आलस्यं कत्थनं धूर्तगोष्ठी मन्त्रादिसाधनम्",
          "english": "",
          "hindi": "",
          "status": "untranslated"
        },
        {
          "number": 31,
          "ref": "yogatattva_upanishad 1.31",
          "text": "धातुस्त्रीलौल्यकादीनि मृगतृष्णामयानि वै । ज्ञात्वा सुधीस्त्यजेत्सर्वान्विघ्नान्पुण्यप्रभावतः",
          "english": "",
          "hindi": "",
          "status": "untranslated"
        },
        {
          "number": 32,
          "ref": "yogatattva_upanishad 1.32",
          "text": "प्राणायामं ततः कुर्यात्पद्मासनगतः स्वयम् । सुशोभनं मठं कुर्यात्सूक्ष्मद्वारं तु निर्व्रणम्",
          "english": "",
          "hindi": "",
          "status": "untranslated"
        },
        {
          "number": 33,
          "ref": "yogatattva_upanishad 1.33",
          "text": "सुष्ठु लिप्तं गोमयेन सुधया वा प्रयत्नतः । मत्कुणैर्मशकैर्लूतैर्वर्जितं च प्रयत्नतः",
          "english": "",
          "hindi": "",
          "status": "untranslated"
        },
        {
          "number": 34,
          "ref": "yogatattva_upanishad 1.34",
          "text": "दिने दिने च संमृष्टं संमार्जन्या विशेषतः । वासितं च सुगन्धेन धूपितं गुग्गुलादिभिः",
          "english": "",
          "hindi": "",
          "status": "untranslated"
        },
        {
          "number": 35,
          "ref": "yogatattva_upanishad 1.35",
          "text": "नात्युच्छ्रितं नातिनीचं चैलाजिनकुशोत्तरम् । तत्रोपविश्य मेधावी पद्मासनसमन्वितः",
          "english": "",
          "hindi": "",
          "status": "untranslated"
        },
        {
          "number": 36,
          "ref": "yogatattva_upanishad 1.36",
          "text": "ऋजुकायः प्राञ्जलिश्च प्रणमेदिष्टदेवताम् । ततो दक्षिणहस्तस्य अङ्गुष्ठेनैव पिङ्गलाम्",
          "english": "",
          "hindi": "",
          "status": "untranslated"
        },
        {
          "number": 37,
          "ref": "yogatattva_upanishad 1.37",
          "text": "निरुध्य पूरयेद्वायुमिडया तु शनैः शनैः । यथाशक्त्यविरोधेन ततः कुर्याच्च कुम्भकम्",
          "english": "",
          "hindi": "",
          "status": "untranslated"
        },
        {
          "number": 38,
          "ref": "yogatattva_upanishad 1.38",
          "text": "पुनस्त्यजेत्पिङ्गलया शनैरेव न वेगतः । पुनः पिङ्गलयापूर्य पूरयेदुदरं शनैः",
          "english": "",
          "hindi": "",
          "status": "untranslated"
        },
        {
          "number": 39,
          "ref": "yogatattva_upanishad 1.39",
          "text": "धारयित्वा यथाशक्ति रेचयेदिडया शनैः । यया त्यजेत्तयापूर्य धारयेदविरोधतः",
          "english": "",
          "hindi": "",
          "status": "untranslated"
        },
        {
          "number": 40,
          "ref": "yogatattva_upanishad 1.40",
          "text": "जानु प्रदक्षिणीकृत्य न द्रुतं न विलम्बितम् । अङ्गुलिस्फोटनं कुर्यात्सा मात्रा परिगीयते",
          "english": "",
          "hindi": "",
          "status": "untranslated"
        },
        {
          "number": 41,
          "ref": "yogatattva_upanishad 1.41",
          "text": "इडया वायुमारोप्य शनैः षोडशमात्रया । कुम्भयेत्पूरितं पश्चाच्चतुःषष्ट्या तु मात्रया",
          "english": "",
          "hindi": "",
          "status": "untranslated"
        },
        {
          "number": 42,
          "ref": "yogatattva_upanishad 1.42",
          "text": "रेचयेत्पिङ्गलानाड्या द्वात्रिंशन्मात्रया पुनः । पुनः पिङ्गलयापूर्य पूर्ववत्सुसमाहितः",
          "english": "",
          "hindi": "",
          "status": "untranslated"
        },
        {
          "number": 43,
          "ref": "yogatattva_upanishad 1.43",
          "text": "प्रातर्मध्यन्दिने सायमर्धरात्रे च कुम्भकान् । शनैरशीतिपर्यन्तं चतुर्वारं समभ्यसेत्",
          "english": "",
          "hindi": "",
          "status": "untranslated"
        },
        {
          "number": 44,
          "ref": "yogatattva_upanishad 1.44",
          "text": "एवं मासत्रयाभ्यासान्नाडीशुद्धिस्ततो भवेत् । यदा तु नाडीशुद्धिः स्यात्तदा चिह्नानि बाह्यतः",
          "english": "",
          "hindi": "",
          "status": "untranslated"
        },
        {
          "number": 45,
          "ref": "yogatattva_upanishad 1.45",
          "text": "जायन्ते योगिनो देहे तानि वक्ष्याम्यशेषतः । शरीरलघुता दीप्तिर्जाठराग्निविवर्धनम्",
          "english": "",
          "hindi": "",
          "status": "untranslated"
        },
        {
          "number": 46,
          "ref": "yogatattva_upanishad 1.46",
          "text": "कृशत्वं च शरीरस्य तदा जायेत निश्चितम् । योगाविघ्नकराहारं वर्जयेद्योगवित्तमः",
          "english": "",
          "hindi": "",
          "status": "untranslated"
        },
        {
          "number": 47,
          "ref": "yogatattva_upanishad 1.47",
          "text": "लवणं सर्षपं चाम्लमुष्णं रूक्षं च तीक्ष्णकम् । शाकजातं रामठादि वह्निस्त्रीपथसेवनम्",
          "english": "",
          "hindi": "",
          "status": "untranslated"
        },
        {
          "number": 48,
          "ref": "yogatattva_upanishad 1.48",
          "text": "प्रातःस्नानोपवासादिकायक्लेशांश्च वर्जयेत् । अभ्यासकाले प्रथमं शस्तं क्षीराज्यभोजनम्",
          "english": "",
          "hindi": "",
          "status": "untranslated"
        },
        {
          "number": 49,
          "ref": "yogatattva_upanishad 1.49",
          "text": "गोधूममुद्गशाल्यन्नं योगवृद्धिकरं विदुः । ततः परं यथेष्टं तु शक्तः स्याद्वायुधारणे",
          "english": "",
          "hindi": "",
          "status": "untranslated"
        },
        {
          "number": 50,
          "ref": "yogatattva_upanishad 1.50",
          "text": "यथेष्टवायुधारणाद्वायोः सिद्ध्येत्केवलकुम्भकः । केवले कुम्भक सिद्धे रेचपूरविवर्जिते",
          "english": "",
          "hindi": "",
          "status": "untranslated"
        },
        {
          "number": 51,
          "ref": "yogatattva_upanishad 1.51",
          "text": "न तस्य दुर्लभं किञ्चित्त्रिषु लोकेषु विद्यते । प्रस्वेदो जायते पूर्वं मर्दनं तेन कारयेत्",
          "english": "",
          "hindi": "",
          "status": "untranslated"
        },
        {
          "number": 52,
          "ref": "yogatattva_upanishad 1.52",
          "text": "ततोऽपि धारणाद्वायोः क्रमेणैव शनैः शनैः । कम्पो भवति देहस्य आसनस्थस्य देहिनः",
          "english": "",
          "hindi": "",
          "status": "untranslated"
        },
        {
          "number": 53,
          "ref": "yogatattva_upanishad 1.53",
          "text": "ततोऽधिकतराभ्यासाद्दार्दुरी स्वेन जायते । यथा च दर्दुरो भाव उत्प्लुन्योत्प्लुत्य गच्छति",
          "english": "",
          "hindi": "",
          "status": "untranslated"
        },
        {
          "number": 54,
          "ref": "yogatattva_upanishad 1.54",
          "text": "पद्मासनस्थितो योगी तथा गच्छति भूतले । ततोऽधिकतरभ्यासाद्भूमित्यागश्च जायते",
          "english": "",
          "hindi": "",
          "status": "untranslated"
        },
        {
          "number": 55,
          "ref": "yogatattva_upanishad 1.55",
          "text": "पद्मासनस्थ एवासौ भूमिमुत्सृज्य वर्तते । अतिमानुषचेष्टादि तथा सामर्थ्यमुद्भवेत्",
          "english": "",
          "hindi": "",
          "status": "untranslated"
        },
        {
          "number": 56,
          "ref": "yogatattva_upanishad 1.56",
          "text": "न दर्शयेच्च सामर्थ्यं दर्शनं वीर्यवत्तरम् । स्वल्पं वा बहुधा दुःखं योगी न व्यथते तदा",
          "english": "",
          "hindi": "",
          "status": "untranslated"
        },
        {
          "number": 57,
          "ref": "yogatattva_upanishad 1.57",
          "text": "अल्पमूत्रपुरीषश्च स्वल्पनिद्रश्च जायते । कीलवो दृषिका लाला स्वेददुर्गन्धतानने",
          "english": "",
          "hindi": "",
          "status": "untranslated"
        },
        {
          "number": 58,
          "ref": "yogatattva_upanishad 1.58",
          "text": "एतानि सर्वथा तस्य न जायन्ते ततः परम् । ततोऽधिकतराभ्यासाद्बलमुत्पद्यते बहु",
          "english": "",
          "hindi": "",
          "status": "untranslated"
        },
        {
          "number": 59,
          "ref": "yogatattva_upanishad 1.59",
          "text": "येन भूचर सिद्धिः स्याद्भूचराणां जये क्षमः । व्याघ्रो वा शरभो व्यापि गजो गवय एव वा",
          "english": "",
          "hindi": "",
          "status": "untranslated"
        },
        {
          "number": 60,
          "ref": "yogatattva_upanishad 1.60",
          "text": "सिंहो वा योगिना तेन म्रियन्ते हस्तताडिताः । कन्दर्पस्य यथा रूपं तथा स्यादपि योगिनः",
          "english": "",
          "hindi": "",
          "status": "untranslated"
        },
        {
          "number": 61,
          "ref": "yogatattva_upanishad 1.61",
          "text": "तद्रूपवशगा नार्यः काङ्क्षन्ते तस्य सङ्गमम् । यदि सङ्गं करोत्येष तस्य बिन्दुक्षयो भवेत्",
          "english": "",
          "hindi": "",
          "status": "untranslated"
        },
        {
          "number": 62,
          "ref": "yogatattva_upanishad 1.62",
          "text": "वर्जयित्वा स्त्रियाः सङ्गं कुर्यादभ्यासमादरात् । योगिनोऽङ्गे सुगन्धश्च जायते बिन्दुधारणात्",
          "english": "",
          "hindi": "",
          "status": "untranslated"
        },
        {
          "number": 63,
          "ref": "yogatattva_upanishad 1.63",
          "text": "ततो रहस्युपाविष्टः प्रणवं प्लुतमात्रया । जपेत्पूर्वार्जितानां तु पापानां नाशहेतवे",
          "english": "",
          "hindi": "",
          "status": "untranslated"
        },
        {
          "number": 64,
          "ref": "yogatattva_upanishad 1.64",
          "text": "सर्वविघ्नहरो मन्त्रः प्रणवः सर्वदोषहा । एवमभ्यासयोगेन सिद्धिरारम्भसम्भवा",
          "english": "",
          "hindi": "",
          "status": "untranslated"
        },
        {
          "number": 65,
          "ref": "yogatattva_upanishad 1.65",
          "text": "ततो भवेद्धठावस्था पवनाभ्यासतत्परा । प्राणोऽपानो मनो बुद्धिर्जीवात्मपरमात्मनोः",
          "english": "",
          "hindi": "",
          "status": "untranslated"
        },
        {
          "number": 66,
          "ref": "yogatattva_upanishad 1.66",
          "text": "अन्योन्यस्याविरोधेन एकता घटते यदा । घटावस्थेति सा प्रोक्ता तच्चिह्नानि ब्रवीम्यहम्",
          "english": "",
          "hindi": "",
          "status": "untranslated"
        },
        {
          "number": 67,
          "ref": "yogatattva_upanishad 1.67",
          "text": "पूर्वं यः कथितोऽभ्यासश्चतुर्थांशं परिग्रहेत् । दिवा वा यदि वा सायं याममात्रं समभ्यसेत्",
          "english": "",
          "hindi": "",
          "status": "untranslated"
        },
        {
          "number": 68,
          "ref": "yogatattva_upanishad 1.68",
          "text": "एकवारं प्रतिदिनं कुर्यात्केवलकुम्भकम् । इन्द्रियाणीन्द्रियार्थेभ्यो यत्प्रत्याहरणं स्फुटम्",
          "english": "",
          "hindi": "",
          "status": "untranslated"
        },
        {
          "number": 69,
          "ref": "yogatattva_upanishad 1.69",
          "text": "योगी कुम्भकमास्थाय प्रत्याहारः स उच्यते । यद्यत्पश्यति चक्षुर्भ्यां तत्तदात्मेति भावयेत्",
          "english": "",
          "hindi": "",
          "status": "untranslated"
        },
        {
          "number": 70,
          "ref": "yogatattva_upanishad 1.70",
          "text": "यद्यच्छृणोति कर्णाभ्यां तत्तदात्मेति भावयेत् । लभते नासया यद्यत्तत्तदात्मेति भावयेत्",
          "english": "",
          "hindi": "",
          "status": "untranslated"
        },
        {
          "number": 71,
          "ref": "yogatattva_upanishad 1.71",
          "text": "जिह्वया यद्रसं ह्यत्ति तत्तदात्मेति भावयेत् । त्वचा यद्यत्स्पृशेद्योगी तत्तदात्मेति भावयेत्",
          "english": "",
          "hindi": "",
          "status": "untranslated"
        },
        {
          "number": 72,
          "ref": "yogatattva_upanishad 1.72",
          "text": "एवं ज्ञानेन्द्रियाणां तु तत्तत्सौख्यं सुसाधयेत् । याममात्रं प्रतिदिनं योगी यत्नादतन्द्रितः",
          "english": "",
          "hindi": "",
          "status": "untranslated"
        },
        {
          "number": 73,
          "ref": "yogatattva_upanishad 1.73",
          "text": "यथा वा चित्तसामर्थ्यं जायते योगिनो ध्रुवम् । दूरश्रुतिर्दूरदृष्टिः क्षणाद्दूरगमस्तथा",
          "english": "",
          "hindi": "",
          "status": "untranslated"
        },
        {
          "number": 74,
          "ref": "yogatattva_upanishad 1.74",
          "text": "वाक्सिद्धिः कामरूपत्वमदृश्यकरणी तथा । मलमूत्रप्रलेपेन लोहादेः स्वर्णता भवेत्",
          "english": "",
          "hindi": "",
          "status": "untranslated"
        },
        {
          "number": 75,
          "ref": "yogatattva_upanishad 1.75",
          "text": "खे गतिस्तस्य जायेत सन्तताभ्यासयोगतः । सदा बुद्धिमता भाव्यं योगिना योगसिद्धये",
          "english": "",
          "hindi": "",
          "status": "untranslated"
        },
        {
          "number": 76,
          "ref": "yogatattva_upanishad 1.76",
          "text": "एते विघ्ना महासिद्धेर्न रमेत्तेषु बुद्धिमान् । न दर्शयेत्स्वसामर्थ्यं यस्यकस्यापि योगिराट्",
          "english": "",
          "hindi": "",
          "status": "untranslated"
        },
        {
          "number": 77,
          "ref": "yogatattva_upanishad 1.77",
          "text": "यथा मूढो यथा मूर्खो यथा बधिर एव वा । तथा वर्तेत लोकस्य स्वसामर्थ्यस्य गुप्तये",
          "english": "",
          "hindi": "",
          "status": "untranslated"
        },
        {
          "number": 78,
          "ref": "yogatattva_upanishad 1.78",
          "text": "शिष्याश्च स्वस्वकार्येषु प्रार्थयन्ति न संशयः । तत्तत्कर्मकरव्यग्रः स्वाभ्यासेऽविस्मृतो भवेत्",
          "english": "",
          "hindi": "",
          "status": "untranslated"
        },
        {
          "number": 79,
          "ref": "yogatattva_upanishad 1.79",
          "text": "अविस्मृत्य गुरोर्वाक्यमभ्यसेत्तदहर्निशम् । एवं भवेद्धठावस्था सन्तताभ्यासयोगतः",
          "english": "",
          "hindi": "",
          "status": "untranslated"
        },
        {
          "number": 80,
          "ref": "yogatattva_upanishad 1.80",
          "text": "अनभ्यासवतश्चैव वृथागोष्ठ्या न सिद्ध्यति । तस्मात्सर्वप्रयत्नेन योगमेव सदाभ्यसेत्",
          "english": "",
          "hindi": "",
          "status": "untranslated"
        },
        {
          "number": 81,
          "ref": "yogatattva_upanishad 1.81",
          "text": "ततः परिचयावस्था जायतेऽभ्यासयोगतः । वायुः परिचितो यत्नादग्निना सह कुण्डलीम्",
          "english": "",
          "hindi": "",
          "status": "untranslated"
        },
        {
          "number": 82,
          "ref": "yogatattva_upanishad 1.82",
          "text": "भावयित्वा सुषुम्नायां प्रविशेदनिरोधतः । वायुना सह चित्तं च प्रविशेच्च महापथम्",
          "english": "",
          "hindi": "",
          "status": "untranslated"
        },
        {
          "number": 83,
          "ref": "yogatattva_upanishad 1.83",
          "text": "यस्य चित्तं स्वपवनं सुषुम्नां प्रविशेदिह । भूमिरापोऽनलो वायुराकाशश्चेति पञ्चकः",
          "english": "",
          "hindi": "",
          "status": "untranslated"
        },
        {
          "number": 84,
          "ref": "yogatattva_upanishad 1.84",
          "text": "येषु पञ्चसु देवानां धारणा पञ्चधोद्यते । पादादिजानुपर्यन्तं पृथिवीस्थानमुच्यते",
          "english": "",
          "hindi": "",
          "status": "untranslated"
        },
        {
          "number": 85,
          "ref": "yogatattva_upanishad 1.85",
          "text": "पृथिवी चतुरस्रं च पीतवर्णं लवर्णकम् । पार्थिवे वायुमारोप्य लकारेण समन्वितम्",
          "english": "",
          "hindi": "",
          "status": "untranslated"
        },
        {
          "number": 86,
          "ref": "yogatattva_upanishad 1.86",
          "text": "ध्यायंश्चतुर्भुजाकारं चतुर्वक्त्रं हिरण्मयम् । धारयेत्पञ्चघटिकाः पृथिवीजयमाप्नुयात्",
          "english": "",
          "hindi": "",
          "status": "untranslated"
        },
        {
          "number": 87,
          "ref": "yogatattva_upanishad 1.87",
          "text": "पृथिवीयोगतो मृत्युर्न भवेदस्य योगिनः । आजानोः पायुपर्यन्तमपां स्थानं प्रकीर्तितम्",
          "english": "",
          "hindi": "",
          "status": "untranslated"
        },
        {
          "number": 88,
          "ref": "yogatattva_upanishad 1.88",
          "text": "आपोऽर्धचन्द्रं शुक्लं च वंबीजं परिकीर्तितम् । वारुणे वायुमारोप्य वकारेण समन्वितम्",
          "english": "",
          "hindi": "",
          "status": "untranslated"
        },
        {
          "number": 89,
          "ref": "yogatattva_upanishad 1.89",
          "text": "स्मरन्नारायणं देवं चतुर्बाहुं किरीटिनम् । शुद्धस्फटिकसङ्काशं पीतवाससमच्युतम्",
          "english": "",
          "hindi": "",
          "status": "untranslated"
        },
        {
          "number": 90,
          "ref": "yogatattva_upanishad 1.90",
          "text": "धारयेत्पञ्चघटिकाः सर्वपापैः प्रमुच्यते । ततो जलाद्भयं नास्ति जले मृत्युर्न विद्यते",
          "english": "",
          "hindi": "",
          "status": "untranslated"
        },
        {
          "number": 91,
          "ref": "yogatattva_upanishad 1.91",
          "text": "आपायोर्हृदयान्तं च वह्निस्थानं प्रकीर्तितम् । वह्निस्त्रिकोणं रक्तं च रेफाक्षरसमुद्भवम्",
          "english": "",
          "hindi": "",
          "status": "untranslated"
        },
        {
          "number": 92,
          "ref": "yogatattva_upanishad 1.92",
          "text": "वह्नौ चानिलमारोप्य रेफाक्षरसमुज्ज्वलम् । त्रियक्षं वरदं रुद्रं तरुणादित्यसंनिभम्",
          "english": "",
          "hindi": "",
          "status": "untranslated"
        },
        {
          "number": 93,
          "ref": "yogatattva_upanishad 1.93",
          "text": "भस्मोद्धूलितसर्वाङ्गं सुप्रसन्नमनुस्मरन् । धारयेत्पञ्चघटिका वह्निनासौ न दाह्यते",
          "english": "",
          "hindi": "",
          "status": "untranslated"
        },
        {
          "number": 94,
          "ref": "yogatattva_upanishad 1.94",
          "text": "न दह्यते शरीरं च प्रविष्टस्याग्निमण्डले । आहृदयाद्भ्रुवोर्मध्यं वायुस्थानं प्रकीर्तितम्",
          "english": "",
          "hindi": "",
          "status": "untranslated"
        },
        {
          "number": 95,
          "ref": "yogatattva_upanishad 1.95",
          "text": "वायुः षट्कोणकं कृष्णं यकाराक्षरभासुरम् । मारुतं मरुतां स्थाने यकाराक्षरभासुरम्",
          "english": "",
          "hindi": "",
          "status": "untranslated"
        },
        {
          "number": 96,
          "ref": "yogatattva_upanishad 1.96",
          "text": "धारयेत्तत्र सर्वज्ञमीश्वरं विश्वतोमुखम् । धारयेत्पञ्चघटिका वायुवद्व्योमगो भवेत्",
          "english": "",
          "hindi": "",
          "status": "untranslated"
        },
        {
          "number": 97,
          "ref": "yogatattva_upanishad 1.97",
          "text": "मरणं न तु वायोश्च भयं भवति योगिनः । आभ्रूमध्यात्तु मूर्धान्तमाकाशस्थानमुच्यते",
          "english": "",
          "hindi": "",
          "status": "untranslated"
        },
        {
          "number": 98,
          "ref": "yogatattva_upanishad 1.98",
          "text": "व्योम वृत्तं च धूम्रं च हकाराक्षरभासुरम् । आकाशे वायुमारोप्य हकारोपरि शङ्करम्",
          "english": "",
          "hindi": "",
          "status": "untranslated"
        },
        {
          "number": 99,
          "ref": "yogatattva_upanishad 1.99",
          "text": "बिन्दुरूपं महादेवं व्योमाकारं सदाशिवम् । शुद्धस्फटिकसङ्काशं धृतबालेन्दुमौलिनम्",
          "english": "",
          "hindi": "",
          "status": "untranslated"
        },
        {
          "number": 100,
          "ref": "yogatattva_upanishad 1.100",
          "text": "पञ्चवक्त्रयुतं सौम्यं दशबाहुं त्रिलोचनम् । सर्वायुधैर्धृताकारं सर्वभूषणभूषितम्",
          "english": "",
          "hindi": "",
          "status": "untranslated"
        },
        {
          "number": 101,
          "ref": "yogatattva_upanishad 1.101",
          "text": "उमार्धदेहं वरदं सर्वकारणकारणम् । आकाशधारणात्तस्य खेचरत्वं भवेद्ध्रुवम्",
          "english": "",
          "hindi": "",
          "status": "untranslated"
        },
        {
          "number": 102,
          "ref": "yogatattva_upanishad 1.102",
          "text": "यत्रकुत्र स्थितो वापि सुखमत्यन्तमश्नुते । एवं च धारणाः पञ्च कुर्याद्योगी विचक्षणः",
          "english": "",
          "hindi": "",
          "status": "untranslated"
        },
        {
          "number": 103,
          "ref": "yogatattva_upanishad 1.103",
          "text": "ततो दृढशरीरः स्यान्मृत्युस्तस्य न विद्यते । ब्रह्मणः प्रलयेनापि न सीदति महामतिः",
          "english": "",
          "hindi": "",
          "status": "untranslated"
        },
        {
          "number": 104,
          "ref": "yogatattva_upanishad 1.104",
          "text": "समभ्यसेत्तथा ध्यानं घटिकाषष्टिमेव च । वायुं निरुध्य चाकाशे देवतामिष्टदामिति",
          "english": "",
          "hindi": "",
          "status": "untranslated"
        },
        {
          "number": 105,
          "ref": "yogatattva_upanishad 1.105",
          "text": "सगुणं ध्यानमेतत्स्यादणिमादिगुणप्रदम् । निर्गुणध्यानयुक्तस्य समाधिश्च ततो भवेत्",
          "english": "",
          "hindi": "",
          "status": "untranslated"
        },
        {
          "number": 106,
          "ref": "yogatattva_upanishad 1.106",
          "text": "दिनद्वादशकेनैव समाधिं समवाप्नुयात् । वायुं निरुध्य मेधावी जीवन्मुक्तो भवत्ययम्",
          "english": "",
          "hindi": "",
          "status": "untranslated"
        },
        {
          "number": 107,
          "ref": "yogatattva_upanishad 1.107",
          "text": "समाधिः समतावस्था जीवात्मपरमात्मनोः । यदि स्वदेहमुत्स्रष्टुमिच्छा चेदुत्सृजेत्स्वयम्",
          "english": "",
          "hindi": "",
          "status": "untranslated"
        },
        {
          "number": 108,
          "ref": "yogatattva_upanishad 1.108",
          "text": "परब्रह्मणि लीयेत न तस्योत्क्रान्तिरिष्यते । अथ नो चेत्समुत्स्रष्टुं स्वशरीरं प्रियं यदि",
          "english": "",
          "hindi": "",
          "status": "untranslated"
        },
        {
          "number": 109,
          "ref": "yogatattva_upanishad 1.109",
          "text": "सर्वलोकेषु विहरन्नणिमादिगुणान्वितः । कदाचित्स्वेच्छया देवो भूत्वा स्वर्गे महीयते",
          "english": "",
          "hindi": "",
          "status": "untranslated"
        },
        {
          "number": 110,
          "ref": "yogatattva_upanishad 1.110",
          "text": "मनुष्यो वापि यक्षो वा स्वेच्छयापीक्षणद्भवेत् । सिंहो व्याघ्रो गजो वाश्वः स्वेच्छया बहुतामियात्",
          "english": "",
          "hindi": "",
          "status": "untranslated"
        },
        {
          "number": 111,
          "ref": "yogatattva_upanishad 1.111",
          "text": "यथेष्टमेव वर्तेत यद्वा योगी महेश्वरः । अभ्यासभेदतो भेदः फलं तु सममेव हि",
          "english": "",
          "hindi": "",
          "status": "untranslated"
        },
        {
          "number": 112,
          "ref": "yogatattva_upanishad 1.112",
          "text": "पार्ष्णिं वामस्य पादस्य योनिस्थाने नियोजयेत् । प्रसार्य दक्षिणं पादं हस्ताभ्यां धारयेद्दृढम्",
          "english": "",
          "hindi": "",
          "status": "untranslated"
        },
        {
          "number": 113,
          "ref": "yogatattva_upanishad 1.113",
          "text": "चुबुकं हृदि विन्यस्य पूरयेद्वायुना पुनः । कुम्भकेन यथाशक्ति धारयित्वा तु रेचयेत्",
          "english": "",
          "hindi": "",
          "status": "untranslated"
        },
        {
          "number": 114,
          "ref": "yogatattva_upanishad 1.114",
          "text": "वामाङ्गेन समभ्यस्य दक्षाङ्गेन ततोऽभ्यसेत् । प्रसारितस्तु यः पादस्तमूरूपरि नामयेत्",
          "english": "",
          "hindi": "",
          "status": "untranslated"
        },
        {
          "number": 115,
          "ref": "yogatattva_upanishad 1.115",
          "text": "अयमेव महाबन्ध उभयत्रैवमभ्यसेत् । महाबन्धस्थितो योगी कृत्वा पूरकमेकधीः",
          "english": "",
          "hindi": "",
          "status": "untranslated"
        },
        {
          "number": 116,
          "ref": "yogatattva_upanishad 1.116",
          "text": "वायुना गतिमावृत्य निभृतं कर्णमुद्रया । पुटद्वयं समाक्रम्य वायुः स्फुरति सत्वरम्",
          "english": "",
          "hindi": "",
          "status": "untranslated"
        },
        {
          "number": 117,
          "ref": "yogatattva_upanishad 1.117",
          "text": "अयमेव महावेधः सिद्धैरभ्यस्यतेऽनिशम् । अन्तः कपालकुहरे जिह्वां व्यावृत्य धारयेत्",
          "english": "",
          "hindi": "",
          "status": "untranslated"
        },
        {
          "number": 118,
          "ref": "yogatattva_upanishad 1.118",
          "text": "भ्रूमध्यदृष्टिरप्येषा मुद्रा भवति खेचरी । कण्ठमाकुञ्च्य हृदये स्थापयेद्दृढया धिया",
          "english": "",
          "hindi": "",
          "status": "untranslated"
        },
        {
          "number": 119,
          "ref": "yogatattva_upanishad 1.119",
          "text": "बन्धो जालन्धराख्योऽयं मृत्युमातङ्गकेसरी । बन्धो येन सुषुम्नायां प्राणस्तूड्डीयते यतः",
          "english": "",
          "hindi": "",
          "status": "untranslated"
        },
        {
          "number": 120,
          "ref": "yogatattva_upanishad 1.120",
          "text": "उड्यानाख्यो हि बन्धोऽयं योगिभिः समुदाहृतः । पार्ष्णिभागेन सम्पीड्य योनिमाकुञ्चयेद्दृढम्",
          "english": "",
          "hindi": "",
          "status": "untranslated"
        },
        {
          "number": 121,
          "ref": "yogatattva_upanishad 1.121",
          "text": "अपानमूर्ध्वमुत्थाप्य योनिबन्धोऽयमुच्यते । प्राणापानौ नादबिन्दू मूलबन्धेन चैकताम्",
          "english": "",
          "hindi": "",
          "status": "untranslated"
        },
        {
          "number": 122,
          "ref": "yogatattva_upanishad 1.122",
          "text": "गत्वा योगस्य संसिद्धिं यच्छतो नात्र संशयः । करणी विपरीताख्या सर्वव्याधिविनाशिनी",
          "english": "",
          "hindi": "",
          "status": "untranslated"
        },
        {
          "number": 123,
          "ref": "yogatattva_upanishad 1.123",
          "text": "नित्यमभ्यासयुक्तस्य जाठराग्निविवर्धनी । आहारो बहुलस्तस्य सम्पाद्यः साधकस्य च",
          "english": "",
          "hindi": "",
          "status": "untranslated"
        },
        {
          "number": 124,
          "ref": "yogatattva_upanishad 1.124",
          "text": "अल्पाहारो यदि भवेदग्निर्देहं हरेत्क्षणात् । अधःशिरश्चोर्ध्वपादः क्षणं स्यात्प्रथमे दिने",
          "english": "",
          "hindi": "",
          "status": "untranslated"
        },
        {
          "number": 125,
          "ref": "yogatattva_upanishad 1.125",
          "text": "क्षणाच्च किञ्चिदधिकमभ्यसेत्तु दिनेदिने । वली च पलितं चैव षण्मासार्धान्न दृश्यते",
          "english": "",
          "hindi": "",
          "status": "untranslated"
        },
        {
          "number": 126,
          "ref": "yogatattva_upanishad 1.126",
          "text": "याममात्रं तु यो नित्यमभ्यसेत्स तु कालजित् । वज्रोलीमभ्यसेद्यस्तु स योगी सिद्धिभाजनम्",
          "english": "",
          "hindi": "",
          "status": "untranslated"
        },
        {
          "number": 127,
          "ref": "yogatattva_upanishad 1.127",
          "text": "लभ्यते यदि तस्यैव योगसिद्धिः करे स्थिता । अतीतानागतं वेत्ति खेचरी च भवेद्ध्रुवम्",
          "english": "",
          "hindi": "",
          "status": "untranslated"
        },
        {
          "number": 128,
          "ref": "yogatattva_upanishad 1.128",
          "text": "अमरीं यः पिबेन्नित्यं नस्यं कुर्वन्दिने दिने । वज्रोलीमभ्यसेन्नित्यममरोलीति कथ्यते",
          "english": "",
          "hindi": "",
          "status": "untranslated"
        },
        {
          "number": 129,
          "ref": "yogatattva_upanishad 1.129",
          "text": "ततो भवेद्राजयोगो नान्तरा भवति ध्रुवम् । यदा तु राजयोगेन निष्पन्ना योगिभिः क्रिया",
          "english": "",
          "hindi": "",
          "status": "untranslated"
        },
        {
          "number": 130,
          "ref": "yogatattva_upanishad 1.130",
          "text": "तदा विवेकवैराग्यं जायते योगिनो ध्रुवम् । विष्णुर्नाम महायोगी महाभूतो महातपाः",
          "english": "",
          "hindi": "",
          "status": "untranslated"
        },
        {
          "number": 131,
          "ref": "yogatattva_upanishad 1.131",
          "text": "तत्त्वमार्गे यथा दीपो दृश्यते पुरुषोत्तमः । यः स्तनः पूर्वपीतस्तं निष्पीड्य मुदमश्नुते",
          "english": "",
          "hindi": "",
          "status": "untranslated"
        },
        {
          "number": 132,
          "ref": "yogatattva_upanishad 1.132",
          "text": "यस्माज्जातो भगात्पूर्वं तस्मिन्नेव भगे रमन् । या माता सा पुनर्भार्या या भार्या मातरेव हि",
          "english": "",
          "hindi": "",
          "status": "untranslated"
        },
        {
          "number": 133,
          "ref": "yogatattva_upanishad 1.133",
          "text": "यः पिता स पुनः पुत्रो यः पुत्रः स पुनः पिता । एवं संसारचक्रं कूपचक्रेण घटा इव",
          "english": "",
          "hindi": "",
          "status": "untranslated"
        },
        {
          "number": 134,
          "ref": "yogatattva_upanishad 1.134",
          "text": "भ्रमन्तो योनिजन्मानि श्रुत्वा लोकान्समश्नुते । त्रयो लोकास्त्रयो वेदास्तिस्रः सन्ध्यास्त्रयः स्वराः",
          "english": "",
          "hindi": "",
          "status": "untranslated"
        },
        {
          "number": 135,
          "ref": "yogatattva_upanishad 1.135",
          "text": "त्रयोऽग्नयश्च त्रिगुणाः स्थिताः सर्वे त्रयाक्षरे । त्रयाणामक्षराणां च योऽधीतेऽप्यर्धमक्षरम्",
          "english": "",
          "hindi": "",
          "status": "untranslated"
        },
        {
          "number": 136,
          "ref": "yogatattva_upanishad 1.136",
          "text": "तेन सर्वमिदं प्रोतं तत्सत्यं तत्परं पदम् । पुष्पमध्ये यथा गन्धः पयोमध्ये यथा घृतम्",
          "english": "",
          "hindi": "",
          "status": "untranslated"
        },
        {
          "number": 137,
          "ref": "yogatattva_upanishad 1.137",
          "text": "तिलमध्ये यथा तैलं पाषाणेष्विव काञ्चनम् । हृदि स्थाने स्थितं पद्मं तस्य वक्त्रमधोमुखम्",
          "english": "",
          "hindi": "",
          "status": "untranslated"
        },
        {
          "number": 138,
          "ref": "yogatattva_upanishad 1.138",
          "text": "ऊर्ध्वनालमधोबिन्दुस्तस्य मध्ये स्थितं मनः । अकारे रेचितं पद्ममुकारेणैव भिद्यते",
          "english": "",
          "hindi": "",
          "status": "untranslated"
        },
        {
          "number": 139,
          "ref": "yogatattva_upanishad 1.139",
          "text": "मकारे लभते नादमर्धमात्रा तु निश्चला । शुद्धस्फटिकसङ्काशं निष्कलं पापनाशनम्",
          "english": "",
          "hindi": "",
          "status": "untranslated"
        },
        {
          "number": 140,
          "ref": "yogatattva_upanishad 1.140",
          "text": "लभते योगयुक्तात्मा पुरुषस्तत्परं पदम् । कूर्मः स्वपाणिपादादिशिरश्चात्मनि धारयेत्",
          "english": "",
          "hindi": "",
          "status": "untranslated"
        },
        {
          "number": 141,
          "ref": "yogatattva_upanishad 1.141",
          "text": "एवं द्वारेषु सर्वेषु वायुपूरितरेचितः । निषिद्धं तु नवद्वारे ऊर्ध्वं प्राङ्निश्वसंस्तथा",
          "english": "",
          "hindi": "",
          "status": "untranslated"
        },
        {
          "number": 142,
          "ref": "yogatattva_upanishad 1.142",
          "text": "घटमध्ये यथा दीपो निवातं कुम्भकं विदुः । निषिद्धैर्नवभिर्द्वारैर्निर्जने निरुपद्रवे",
          "english": "",
          "hindi": "",
          "status": "untranslated"
        }
      ]
    }
  ]
}
